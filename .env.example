# Example .env — copy this file to `.env` and fill in your own values.
# The real `.env` is git-ignored and must NEVER be committed.
#
# These variables are referenced elsewhere as ${GIT_USERNAME} and
# ${GIT_ACCESS_TOKEN}; never hard-code the token.

# Your Git username (or the email associated with your account).
GIT_USERNAME=your-username

# A Git personal access token (example format shown — use your own).
GIT_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
